{
    "name": "kontainer/laravel-model-cache",
    "type": "library",
    "description": "A Redis based, automated and scalable database caching layer for Laravel",
    "license": "MIT",
    "keywords": [
        "php",
        "laravel",
        "cache",
        "caching",
        "redis",
        "database",
        "eloquent",
        "model"
    ],
    "authors": [
        {
            "name": "Kontainer",
            "homepage": "https://kontainer.com",
            "role": "Maintainer"
        },
        {
            "name": "Matthias Isler",
            "email": "mi@matthias-isler.ch",
            "role": "Original author of Lada Cache"
        }
    ],
    "support": {
        "issues": "https://github.com/Kontainer-Dam-and-Pim/laravel-model-cache/issues",
        "source": "https://github.com/Kontainer-Dam-and-Pim/laravel-model-cache"
    },
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.40",
        "illuminate/database": "^13.40",
        "illuminate/redis": "^13.40"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^11.0",
        "mockery/mockery": "^1.6",
        "fruitcake/laravel-debugbar": "^4.1",
        "predis/predis": "^2.2 || ^3.0",
        "laravel/pint": "^1.25",
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "fruitcake/laravel-debugbar": "Provides debug information about the cache"
    },
    "autoload": {
        "psr-4": {
            "Kontainer\\ModelCache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kontainer\\ModelCache\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Kontainer\\ModelCache\\ModelCacheServiceProvider"
            ]
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    }
}
